# ─────────────────────────────────────────────────────────────
#  Bijlesplatform — omgevingsvariabelen
#  Kopieer dit bestand naar .env.local en vul in wat je hebt.
#  Alles is OPTIONEEL: zonder keys werkt het whiteboard lokaal,
#  video en login schakelen automatisch in zodra je keys invult.
# ─────────────────────────────────────────────────────────────

# ── Supabase (auth, database, realtime) ──
# Aanmaken: https://supabase.com → New Project → Settings → API
# Plak hier de "Project URL" en de "anon public" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (alleen server-side, NOOIT in de browser). Voor admin-acties.
SUPABASE_SERVICE_ROLE_KEY=

# ── Daily.co (video) ──
# Snelste start zonder code: maak op https://dashboard.daily.co een room aan
# en plak de volledige room-URL hieronder (bv. https://jouwteam.daily.co/demo).
NEXT_PUBLIC_DAILY_ROOM_URL=
# Voor automatisch rooms aanmaken per sessie (later): Daily API key.
DAILY_API_KEY=
NEXT_PUBLIC_DAILY_DOMAIN=

# ── Resend (e-mail: magic links / uitnodigingen) ──
# Aanmaken: https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM="Bijles <no-reply@jouwdomein.nl>"

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
